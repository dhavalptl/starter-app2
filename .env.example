# Local Vite only (never used by production Express)

# Upstream service1 — browser calls same-origin /service1/* ; Vite proxies here
SERVICE1_TARGET=http://127.0.0.1:8000

# Use local auth stub instead of proxy (no upstream required)
# SERVICE1_STUB=1

# Set to 1 only when upstream is https with valid certs
# SERVICE1_SECURE=0
